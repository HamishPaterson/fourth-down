{
  "framework": "vite",
  "functions": {
    "api/nfl/sleeper-players.js": {
      "includeFiles": "api/nfl/ea_player_records.json"
    },
    "api/nfl/odds.js": {
      "maxDuration": 60
    },
    "api/nfl/schedule.js": {
      "maxDuration": 60,
      "includeFiles": "api/nfl/ea_player_records.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/weekly-multi/current",
      "destination": "/api/nfl/schedule?weeklyMultiMode=current"
    },
    {
      "source": "/api/weekly-multi/lock",
      "destination": "/api/nfl/schedule?weeklyMultiMode=lock"
    },
    {
      "source": "/api/weekly-multi/prepare",
      "destination": "/api/nfl/schedule?weeklyMultiMode=prepare"
    }
  ],
  "crons": [
    {
      "path": "/api/weekly-multi/lock",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/weekly-multi/lock",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/weekly-multi/prepare",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/nfl/odds?refreshMarket=moneyline",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/nfl/odds?refreshMarket=total_points",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/nfl/odds?refreshMarket=point_spread",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/nfl/odds?refreshMarket=player_pass_yds",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/nfl/odds?refreshMarket=player_rush_yds",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/nfl/odds?refreshMarket=player_receptions",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/nfl/odds?refreshMarket=player_reception_yds",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/nfl/odds?refreshMarket=player_pass_tds",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/nfl/odds?refreshMarket=player_pass_attempts",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/nfl/odds?refreshMarket=player_completions",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/nfl/odds?refreshMarket=player_rush_attempts",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/nfl/odds?refreshMarket=player_rush_reception_yds",
      "schedule": "0 3 * * *"
    }
  ]
}