{
  "framework": "vite",
  "functions": {
    "api/nfl/sleeper-players.js": {
      "includeFiles": "api/nfl/ea_player_records.json"
    }
  },
  "rewrites": [
    {
      "source": "/api/weekly-multi/current",
      "destination": "/api/nfl/schedule?weeklyMultiMode=current"
    },
    {
      "source": "/api/weekly-multi/lock",
      "destination": "/api/nfl/schedule?weeklyMultiMode=lock"
    }
  ],
  "crons": [
    {
      "path": "/api/weekly-multi/lock",
      "schedule": "0 1 * * *"
    }
  ]
}